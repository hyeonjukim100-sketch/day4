# 이 파일을 복사해서 .env 로 만들고 값을 채워 넣으세요. (.env 는 git에 올라가지 않습니다)

# Supabase > Project Settings > API (또는 Connect 버튼)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...  # anon(publishable) 키만! service_role 키는 절대 넣지 마세요

# https://pixabay.com/api/docs/ 에서 발급 (서버 함수에서만 사용 - VITE_ 를 붙이지 않습니다)
PIXABAY_API_KEY=
